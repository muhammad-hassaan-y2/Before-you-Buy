# Copy to .env and adjust. `docker compose` reads this file automatically.

# --- Postgres ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=beforeyoubuy
POSTGRES_PORT=5432

# --- Shared secret for worker -> gateway callbacks (x-byb-token) ---
INTERNAL_TOKEN=dev-internal-token

# --- Published ports ---
GATEWAY_PORT=8001
CATALOG_PORT=8004
INFERENCE_PORT=8002
VISION_PORT=8005
GEOMETRY_PORT=8003
SCENE_PORT=8006
FRONTEND_PORT=3000

# --- Sidecar addresses. Unset one and that hop falls back to direct HTTP. ---
# DAPR_GATEWAY_ENDPOINT=http://dapr-api-gateway:3500
# DAPR_CATALOG_ENDPOINT=http://dapr-catalog-service:3500
# DAPR_INFERENCE_ENDPOINT=http://dapr-inference-service:3500
# DAPR_VISION_ENDPOINT=http://dapr-vision-service:3500
# DAPR_GEOMETRY_ENDPOINT=http://dapr-geometry-service:3500
# DAPR_SCENE_ENDPOINT=http://dapr-scene-service:3500

# --- AMD Token Factory (OpenAI-compatible chat API) ---
# Paste values ONLY from your Token Factory UI / AMD Radeon Cloud docs after redeem.
# Do not invent hostnames or model ids. Env names keep the VLLM_* prefix for compatibility.
# Leave blank to force heuristic fallback until configured.
# For local Compose ROCm: VLLM_BASE_URL=http://vllm:8000/v1 and set VLLM_MODEL.
# Official docs describe Bearer auth and POST .../v1/chat/completions (verify in your UI).
VLLM_PORT=8000
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT_S=60
# VLLM_API_KEY is a secret: set it locally or in CI secrets, never commit the value.

# --- agent-service: the Evolus-facing brain room, the MCP connector and the fit journey ---
AGENT_PORT=8007
# Unset all four and the agent answers from its own heuristics - the demo still runs.
EVOLUS_BASE_URL=https://api.evolus.ai
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_LIBRARY_ID=
# One of the Evolus AI Tools, used to polish the shopper's reply (e.g. translate, simplify).
EVOLUS_REPLY_TOOL=
# The agent reads the shopper's words with the same AMD endpoint the workspace is connected to.
# AGENT_VLLM_BASE_URL=http://<droplet-ip>:8000/v1
# How much work one journey may spend: candidates per pass, fits at a time, seconds to wait.
AGENT_MAX_CANDIDATES=4
AGENT_PARALLEL_FITS=2
AGENT_SETTLE_TIMEOUT_S=120
# How many pieces one `fit_catalog` sweep may measure. Every fit is a GPU job.
AGENT_MAX_CATALOG_FITS=8
# A multi-piece verdict: how many pieces it may add up, and the room it must leave clear.
AGENT_MAX_JOINT_PIECES=4
AGENT_MAX_JOINT_COVERAGE=0.6
AGENT_MIN_WALKWAY_M=0.6
# Public address of this app, so an Evolus workflow can call back. Empty means local only.
PUBLIC_BASE_URL=
# The MCP connector door. Empty key = anyone with the URL can call it, which is a demo setting:
# every fit is a GPU job. ChatGPT and Claude's app cannot send a static key, only OAuth or none,
# so a keyed connector is a Claude Code / Cursor connector. Set MCP_SESSIONS=true to give clients
# a real session, which is how ChatGPT can show the shopper the hold confirmation itself.
AGENT_MCP_CONNECT_TOKEN=
AGENT_MCP_SESSIONS=false
# Browser origins allowed to call agent-service. The MCP Inspector ports are in the default.
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,http://localhost:6274,http://127.0.0.1:6274

# --- Frontend -> gateway proxy target (Next.js rewrites, server-side only) ---
API_GATEWAY_URL=http://localhost:8001
# Frontend -> agent-service proxy target, so the browser never learns the Evolus key.
AGENT_SERVICE_URL=http://localhost:8007
# The Evolus chat widget: one script tag, loaded only when both are set.
NEXT_PUBLIC_EVOLUS_WIDGET_URL=
NEXT_PUBLIC_EVOLUS_WIDGET_SCRIPT=
