# Copy to .env and adjust. `docker compose` reads this file automatically.

# --- Postgres ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=beforeyoubuy
POSTGRES_PORT=5432

# --- Shared secret for worker -> gateway callbacks (x-byb-token) ---
INTERNAL_TOKEN=dev-internal-token

# --- Published ports ---
GATEWAY_PORT=8001
CATALOG_PORT=8004
INFERENCE_PORT=8002
VISION_PORT=8005
GEOMETRY_PORT=8003
FRONTEND_PORT=3000

# --- Sidecar addresses. Unset one and that hop falls back to direct HTTP. ---
# DAPR_GATEWAY_ENDPOINT=http://dapr-api-gateway:3500
# DAPR_CATALOG_ENDPOINT=http://dapr-catalog-service:3500
# DAPR_INFERENCE_ENDPOINT=http://dapr-inference-service:3500
# DAPR_VISION_ENDPOINT=http://dapr-vision-service:3500
# DAPR_GEOMETRY_ENDPOINT=http://dapr-geometry-service:3500

# --- AMD Token Factory (OpenAI-compatible chat API) ---
# Paste values ONLY from your Token Factory UI / AMD Radeon Cloud docs after redeem.
# Do not invent hostnames or model ids. Env names keep the VLLM_* prefix for compatibility.
# Leave blank to force heuristic fallback until configured.
# For local Compose ROCm: VLLM_BASE_URL=http://vllm:8000/v1 and set VLLM_MODEL.
# Official docs describe Bearer auth and POST .../v1/chat/completions (verify in your UI).
VLLM_PORT=8000
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT_S=60
VLLM_SUPPORTS_VISION=false

# --- Frontend -> gateway proxy target (Next.js rewrites, server-side only) ---
API_GATEWAY_URL=http://localhost:8001
